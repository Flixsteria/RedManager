{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RedModManager",
  "mainBinaryName": "RedModManager",
  "version": "1.2.0",
  "identifier": "com.tonimacaroni.redmodmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "RedModManager",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "useHttpsScheme": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/logo_img.png",
      "icons/logo_icon.ico"
    ]
  }
}
